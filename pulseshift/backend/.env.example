# ==========================================
# PulseShift Backend - Environment Config
# ==========================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will NOT be committed.

# 1. YouTube Data API v3 Key
YOUTUBE_API_KEY=

# 2. NewsAPI Key
NEWS_API_KEY=

# 3. Google Gemini API Key
GEMINI_API_KEY=

# 4. OpenRouter API Key & Model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy3

# 5. AI Sentiment Analysis Keys (Optional: Falls back to Heuristic NLP Engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 6. Supabase Database & Realtime (Optional: Falls back to local SQLite)
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
